{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": ["**", "!src/vendor"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100,
    "useEditorconfig": true
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "selfCloseVoidElements": "always"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "domains": {
      "vue": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts", "**/*.vue"],
      "linter": {
        "rules": {
          "style": {
            "useVueHyphenatedAttributes": {
              "level": "warn",
              "options": {
                "ignore": ["ariaLabel"]
              }
            },
            "useVueMultiWordComponentNames": "off"
          }
        }
      }
    },
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "on"
          }
        }
      },
      "includes": ["*.json", "!package.json"]
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
