# API Configuration.

# Base path is used for deploying to GitHub pages.
VITE_BASE_PATH=/pmrapp-frontend/

# Enable SPA redirect helper script for GitHub Pages only.
# Optional for local development and standard hosts/domains; defaults to false when unset.
# This is already set in the GitHub Pages and production deploy workflows.
# Set to true for GitHub Pages project deployments.
VITE_ENABLE_GH_PAGES_SPA_REDIRECT=false

# REQUIRED for production builds: base URL for the PMR API server
# (search, exposures, and workspaces). `vite build` fails if this is missing
# or is not an absolute http(s) URL.
VITE_API_BASE_URL=http://localhost:9380

# GitHub repository variable used by the e2e workflow on GitHub Actions
# to supply VITE_API_BASE_URL (not read by the app).
VITE_API_BASE_URL_PROXY=http://localhost:8787/cors-proxy

# REQUIRED for production builds: API endpoint for downloading COMBINE archives.
VITE_DOWNLOAD_API=http://localhost:8787

# Optional. Base URL for downloading workspace archives.
# If unset, the app uses the current host.
VITE_DOWNLOAD_HOST=http://localhost:9380

# Google Analytics Configuration.
# Optional. GA4 Measurement ID (format: G-XXXXXXXXXX). Leave unset to disable
# analytics. When set, `vite build` checks that it matches the GA4 format.
VITE_GA_MEASUREMENT_ID=

# GitHub OAuth Configuration.
# Visit github.com/settings/developers to create a new OAuth app.
# REQUIRED for production builds: public client ID of the GitHub OAuth app.
VITE_GITHUB_CLIENT_ID=

# REQUIRED for production builds: base URL for the GitHub OAuth
# authentication API server.
VITE_GITHUB_AUTH_API=http://localhost:8788

# Build tooling only (not read by the app, and not read from .env files):
# set SKIP_ENV_VALIDATION=true as a real environment variable to bypass the
# required-variable check on `vite build`. The CI workflow sets this for its
# non-deployment test build; deployment builds must keep it unset so that
# missing variables fail the build.
